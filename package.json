{
	"name": "musicbutler",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"build": "bun run --filter @musicbutler/web build && bun run --filter @musicbutler/server build",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/bun": "1.3.14",
		"typescript": "5.9.3"
	},
	"trustedDependencies": [
		"onnxruntime-node",
		"protobufjs",
		"sharp",
		"@biomejs/biome",
		"esbuild"
	],
	"version": "0.0.1",
	"license": "AGPL-3.0-only"
}
