# Absolute path of your Navidrome music library on the host.
# Mounted READ-WRITE at /music: this is where musicbutler writes .lrc files.
NAVIDROME_MUSIC_DIR=/path/to/your/music

# Owner of the library files. Written .lrc files get this uid/gid (mode 0644),
# so Navidrome can read them. Find yours with: id -u; id -g
PUID=1000
PGID=1000

# Languages to run, comma separated. English is baked into the image and works
# offline at once. Any other language downloads once on the first start, into
# the models volume. Supported: en-US, it-IT
MUSICBUTLER_LANGS=en-US
